-- | Entry point for the PureScript -> Zig backend.
-- |
-- | Spago invokes this with the project root as its working directory, after
-- | running `purs compile --codegen corefn`. The contract is entirely
-- | filesystem-based: read ./output/<Module.Name>/corefn.json, write
-- | ./output-zig/*.zig. No arguments, no stdin, no compiler plugin API.
-- |
-- | STATUS: decodes for real, emits a placeholder. `CoreFn.Decode` is
-- | complete; `Zig.Emit` is not, so the last step still writes a fixed string.
-- | Decoding is reported per module, which makes the decoder independently
-- | testable against real compiler output before any emission exists -- run
-- | `zig build codegen` and read the log.
module Main where

import Prelude

import CoreFn.Decode (decodeModule)
import CoreFn.Types (Bind(..), Module)
import Data.Argonaut.Core (Json)
import Data.Argonaut.Parser (jsonParser)
import Data.Array (filter, length, sort)
import Data.Either (Either(..))
import Data.Foldable (for_)
import Data.String as String
import Effect (Effect)
import Effect.Console (log)
import Node.Encoding (Encoding(..))
import Node.FS.Sync (exists, mkdir, readTextFile, readdir, writeTextFile)

-- | Where `purs compile --codegen corefn` leaves its output.
corefnDir :: String
corefnDir = "output"

-- | Where we put generated Zig. Deliberately NOT `output/`: keeping it
-- | separate means the JavaScript backend and this one can coexist in one
-- | project without fighting over a directory. purerl uses the same convention.
zigDir :: String
zigDir = "output-zig"

main :: Effect Unit
main = do
  hasCorefn <- exists corefnDir
  if not hasCorefn then
    log "[purs-backend-zig] no ./output directory -- did purs run with --codegen corefn?"
  else do
    entries <- readdir corefnDir
    let candidates = sort (filter isModuleDir entries)
    ensureDir zigDir
    log ("[purs-backend-zig] " <> show (length candidates) <> " module director(ies)")
    for_ candidates processModule
    writeTextFile UTF8 (zigDir <> "/Main.zig") stubMain
    log ("[purs-backend-zig] wrote " <> zigDir <> "/Main.zig (PLACEHOLDER, not generated from CoreFn)")

-- | Anything in ./output that is not compiler bookkeeping.
isModuleDir :: String -> Boolean
isModuleDir name = not (String.contains (String.Pattern ".json") name)

ensureDir :: String -> Effect Unit
ensureDir dir = do
  present <- exists dir
  when (not present) (mkdir dir)

-- | Decode one module and report. Emission goes here once `Zig.Emit` exists.
processModule :: String -> Effect Unit
processModule dir = do
  let path = corefnDir <> "/" <> dir <> "/corefn.json"
  present <- exists path
  if not present then
    log ("[purs-backend-zig]   " <> dir <> ": no corefn.json (skipped)")
  else do
    text <- readTextFile UTF8 path
    case parseAndDecode text of
      Left err ->
        log ("[purs-backend-zig]   " <> dir <> ": DECODE FAILED -- " <> err)
      Right m ->
        log ("[purs-backend-zig]   " <> describe m)

parseAndDecode :: String -> Either String Module
parseAndDecode text = do
  json <- jsonParser text
  case decodeModule (json :: Json) of
    Left err -> Left (show err)
    Right m -> Right m

describe :: Module -> String
describe m =
  m.name
    <> " (purs "
    <> m.builtWith
    <> "): "
    <> show (countBindings m.decls)
    <> " binding(s), "
    <> show (length m.foreigns)
    <> " foreign, imports "
    <> show m.imports

countBindings :: Array Bind -> Int
countBindings = foldlBinds 0
  where
  foldlBinds acc binds = acc + sumOf binds

  sumOf binds = length (binds >>= expand)

  expand b = case b of
    NonRec ident _ -> [ ident ]
    Rec group -> map _.identifier group

-- | The fixed output that stands in for real code generation.
-- |
-- | See docs/codegen.md for the emission rules and
-- | purs/example/expected/Main.zig for a hand-written instance of what this
-- | must eventually produce.
stubMain :: String
stubMain =
  """// GENERATED by purs-backend-zig. Do not edit.
//
// PLACEHOLDER. A fixed string, not a translation of CoreFn.
const std = @import("std");
const rt = @import("runtime");
const ffi = @import("ffi");

pub fn main(init: std.process.Init) !void {
    rt.init(init.io, init.arena.allocator());
    const greeting = rt.Value.mkString("Hello from the placeholder emitter");
    _ = rt.runEffect(rt.apply(ffi.zig_prelude.prim.@"ps.log", greeting));
}
"""
